list(APPEND _cmake_import_check_files_for_yyjson::yyjson "${_IMPORT_PREFIX}/@YYJSON_INSTALL_LIBDIR@/@YYJSON_LIBRARY_FILE@" )

set(CMAKE_IMPORT_FILE_VERSION)
