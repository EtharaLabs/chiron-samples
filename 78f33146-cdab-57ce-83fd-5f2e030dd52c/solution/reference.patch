 """
 
 
+WIRE_ERROR_NAMES: dict[str, tuple[str, str]] = {
+    "missing": ("field required", "value_error.missing"),
+    "string_type": ("str type expected", "type_error.str"),
+    "int_parsing": ("value is not a valid integer", "type_error.integer"),
+    "float_parsing": ("value is not a valid float", "type_error.float"),
+    "bool_parsing": ("value could not be parsed to a boolean", "type_error.bool"),
+    "extra_forbidden": ("extra fields not permitted", "value_error.extra"),
+}
+"""The `msg`/`type` pair served for each validation failure, keyed by the validator
+that produced it. These strings are part of this API's response contract and are
+consumed by clients, so they are pinned here rather than taken from the validation
+library, whose own wording is an implementation detail that changes between releases.
+"""
+
+
+def validation_error_details(exc: ValidationError) -> list[dict[str, Any]]:
+    """Render a validation error as the flat `loc`/`msg`/`type` list served by the API."""
+    details = []
+    for error in exc.errors(include_url=False, include_context=False):
+        msg, type_ = error["msg"], error["type"]
+        if type_ in WIRE_ERROR_NAMES:
+            msg, type_ = WIRE_ERROR_NAMES[type_]
+            if error["type"] == "string_type" and error.get("input") is None:
+                msg, type_ = "none is not an allowed value", "type_error.none.not_allowed"
+        elif type_ == "value_error":
+            msg = msg.removeprefix("Value error, ")
+        details.append({"loc": list(error["loc"]), "msg": msg, "type": type_})
+
+    return details
+
+
+def validation_error_message(exc: ValidationError) -> str:
+    """Render a validation error as the multi-line summary served by the API."""
+    details = validation_error_details(exc)
+    lines = [f"{len(details)} validation error{'' if len(details) == 1 else 's'} for {exc.title}"]
+    for detail in details:
+        lines.append(" -> ".join(str(part) for part in detail["loc"]))
+        lines.append(f"  {detail['msg']} (type={detail['type']})")
+
+    return "\n".join(lines)
+
