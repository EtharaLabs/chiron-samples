# Package configuration for yyjson.
#
# It defines the imported target `yyjson::yyjson` and is written by
# `configure_file` rather than generated by `install(EXPORT)`, because the
# library is built by cargo and the project enables no CMake language, so there
# is no library target to export. Consumers see the same target name, the same
# include directory and the same per-configuration files as before.

cmake_policy(PUSH)
cmake_policy(VERSION 2.8.3...3.29)

set(CMAKE_IMPORT_FILE_VERSION 1)

if(TARGET yyjson::yyjson)
  set(CMAKE_IMPORT_FILE_VERSION)
  cmake_policy(POP)
  return()
endif()

# Compute the installation prefix relative to this file.
get_filename_component(_IMPORT_PREFIX "${CMAKE_CURRENT_LIST_FILE}" PATH)
get_filename_component(_IMPORT_PREFIX "${_IMPORT_PREFIX}" PATH)
get_filename_component(_IMPORT_PREFIX "${_IMPORT_PREFIX}" PATH)
get_filename_component(_IMPORT_PREFIX "${_IMPORT_PREFIX}" PATH)
if(_IMPORT_PREFIX STREQUAL "/")
  set(_IMPORT_PREFIX "")
endif()

add_library(yyjson::yyjson @YYJSON_IMPORTED_KIND@ IMPORTED)

set_target_properties(yyjson::yyjson PROPERTIES
  INTERFACE_INCLUDE_DIRECTORIES "${_IMPORT_PREFIX}/@YYJSON_INSTALL_INCLUDEDIR@"
)

# Load information for each installed configuration.
file(GLOB _cmake_config_files "${CMAKE_CURRENT_LIST_DIR}/yyjson-config-*.cmake")
foreach(_cmake_config_file IN LISTS _cmake_config_files)
  include("${_cmake_config_file}")
endforeach()
unset(_cmake_config_file)
unset(_cmake_config_files)

set(_IMPORT_PREFIX)

# Every file the imported target references must exist.
foreach(_cmake_target IN LISTS _cmake_import_check_targets)
  foreach(_cmake_file IN LISTS "_cmake_import_check_files_for_${_cmake_target}")
    if(NOT EXISTS "${_cmake_file}")
      message(FATAL_ERROR "The imported target \"${_cmake_target}\" references the file
   \"${_cmake_file}\"
but this file does not exist.  Possible reasons include:
* The file was deleted, renamed, or moved to another location.
* An install or uninstall procedure did not complete successfully.
* The installation package was faulty and contained
   \"${CMAKE_CURRENT_LIST_FILE}\"
but not all the files it references.
")
    endif()
  endforeach()
  unset(_cmake_file)
  unset("_cmake_import_check_files_for_${_cmake_target}")
endforeach()
unset(_cmake_target)
unset(_cmake_import_check_targets)

set(CMAKE_IMPORT_FILE_VERSION)
cmake_policy(POP)
