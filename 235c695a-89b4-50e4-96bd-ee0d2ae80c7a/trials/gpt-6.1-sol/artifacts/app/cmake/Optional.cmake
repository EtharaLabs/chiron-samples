option(YOSYS_ENABLE_CCACHE "Use ccache" OFF)
option(YOSYS_ENABLE_GCOV "Instrument for LLVM coverage" OFF)
option(YOSYS_ENABLE_FUNCTIONAL_TESTS "Build functional IR tests" OFF)
option(YOSYS_ENABLE_VERIFIC "Enable Verific" OFF)
set(VERIFIC_DIR "${CMAKE_INSTALL_PREFIX}/src/verific_lib" CACHE PATH "Verific installation")
if(YOSYS_ENABLE_CCACHE)
  find_program(CCACHE_EXECUTABLE ccache REQUIRED)
  set(CMAKE_CXX_COMPILER_LAUNCHER "${CCACHE_EXECUTABLE}")
endif()
if(YOSYS_ENABLE_GCOV)
  list(APPEND YOSYS_OPTIONS -fprofile-instr-generate -fcoverage-mapping)
  add_link_options(-fprofile-instr-generate)
endif()
if(YOSYS_ENABLE_VERIFIC)
  list(APPEND YOSYS_DEFINITIONS YOSYS_ENABLE_VERIFIC)
  list(APPEND YOSYS_SOURCES frontends/verific/verificsva.cc)
  set(components database util containers)
  foreach(component HIER_TREE SYSTEMVERILOG VHDL EDIF LIBERTY YOSYSHQ_EXTENSIONS)
    if(component MATCHES "^(HIER_TREE|SYSTEMVERILOG|VHDL)$")
      set(default ON)
    else()
      set(default OFF)
    endif()
    option(YOSYS_ENABLE_VERIFIC_${component} "Verific ${component}" ${default})
  endforeach()
  foreach(pair "HIER_TREE;hier_tree" "SYSTEMVERILOG;verilog" "VHDL;vhdl" "EDIF;edif" "LIBERTY;synlib" "YOSYSHQ_EXTENSIONS;extensions")
    list(GET pair 0 option_name)
    list(GET pair 1 directory)
    if(YOSYS_ENABLE_VERIFIC_${option_name} OR ((option_name MATCHES "HIER_TREE|SYSTEMVERILOG|VHDL|YOSYSHQ_EXTENSIONS") AND IS_DIRECTORY "${VERIFIC_DIR}/${directory}"))
      list(APPEND components ${directory})
    endif()
    if(YOSYS_ENABLE_VERIFIC_${option_name})
      if(option_name STREQUAL "YOSYSHQ_EXTENSIONS")
        list(APPEND YOSYS_DEFINITIONS YOSYSHQ_VERIFIC_EXTENSIONS)
      else()
        list(APPEND YOSYS_DEFINITIONS VERIFIC_${option_name}_SUPPORT)
      endif()
    endif()
  endforeach()
  if("extensions" IN_LIST components)
    list(APPEND YOSYS_SOURCES kernel/log_compat.cc)
  endif()
  foreach(component IN LISTS components)
    list(APPEND YOSYS_INCLUDES "${VERIFIC_DIR}/${component}")
    if(APPLE)
      file(GLOB libraries "${VERIFIC_DIR}/${component}/*-mac.a")
    else()
      file(GLOB libraries "${VERIFIC_DIR}/${component}/*-linux.a")
    endif()
    list(APPEND YOSYS_LIBRARIES "$<LINK_LIBRARY:WHOLE_ARCHIVE,${libraries}>")
  endforeach()
  if(YOSYS_ENABLE_VERIFIC_VHDL)
    foreach(year 1987 1993 2008 2019)
      file(COPY "${VERIFIC_DIR}/vhdl_packages/vdbs_${year}/" DESTINATION "${PROJECT_BINARY_DIR}/share/verific/vhdl_vdbs_${year}")
    endforeach()
  endif()
endif()
