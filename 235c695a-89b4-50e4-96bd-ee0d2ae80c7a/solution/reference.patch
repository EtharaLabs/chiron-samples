+++ b/techlibs/gatemate/CMakeLists.txt
@@ -0,0 +1,69 @@
+yosys_pass(gatemate_foldinv
+	gatemate_foldinv.cc
+)
+
+# The generator writes `techlibs/gatemate/*` relative to its working directory, which is the
+# build directory, so that the source tree is never written to.
+set(lut_tree_dir ${CMAKE_BINARY_DIR}/techlibs/gatemate)
+add_custom_command(
+	DEPENDS make_lut_tree_lib.py
+	OUTPUT ${lut_tree_dir}/lut_tree_cells.genlib ${lut_tree_dir}/lut_tree_map.v
+	COMMAND ${CMAKE_COMMAND} -E make_directory ${lut_tree_dir}
+	COMMAND ${Python3_EXECUTABLE} ${CMAKE_CURRENT_SOURCE_DIR}/make_lut_tree_lib.py
+	WORKING_DIRECTORY ${CMAKE_BINARY_DIR}
+	VERBATIM
+)
+yosys_pass(synth_gatemate
+	synth_gatemate.cc
+	REQUIRES
+		abc
+		alumacc
+		blackbox
+		check
+		clean
+		clkbufmap
+		deminout
+		dfflegalize
+		flatten
+		fsm
+		gatemate_foldinv
+		hierarchy
+		iopadmap
+		memory
+		memory_libmap
+		memory_map
+		muxcover
+		muxpack
+		opt
+		opt_clean
+		opt_expr
+		peepopt
+		proc
+		read_verilog
+		share
+		simplemap
+		stat
+		techmap
+		tribuf
+		wreduce
+		write_json
+		write_verilog
+	DATA_DIR
+		gatemate
+	DATA_FILES
+		reg_map.v
+		mux_map.v
+		lut_map.v
+		mul_map.v
+		arith_map.v
+		cells_sim.v
+		cells_bb.v
+		brams_map.v
+		brams.txt
+		brams_init_20.vh
+		brams_init_40.vh
+		inv_map.v
+	DATA_EXPLICIT
+		lut_tree_cells.genlib ${lut_tree_dir}/lut_tree_cells.genlib
+		lut_tree_map.v ${lut_tree_dir}/lut_tree_map.v
+)
