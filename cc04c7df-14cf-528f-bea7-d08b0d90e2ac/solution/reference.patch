+import org.apache.logging.log4j.LogManager;
+import org.apache.logging.log4j.Logger;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.scheduling.annotation.SchedulingConfigurer;
+import org.springframework.scheduling.config.ScheduledTaskRegistrar;
+import org.springframework.scheduling.support.CronTrigger;
+import org.springframework.stereotype.Component;
+
+/**
+ * {@link Component} which schedules the <code>Team Competition</code> stats retrieval for the system, when
+ * {@code ENABLE_STATS_SCHEDULED_PARSING} is <b>true</b>. The schedule is built from the {@code STATS_PARSING_SCHEDULE_*}
+ * environment variables (second, minute and hour, and the day-of-month window from the first to the last day), in UTC.
+ * By default the stats are parsed every hour at <b>55</b> minutes past the hour, from the 3rd of the month until its end.
+ */
+@Component
+public class StatsScheduler implements SchedulingConfigurer {
+
+    private static final Logger LOGGER = LogManager.getLogger();
+    private static final boolean IS_STATS_SCHEDULED_PARSING_ENABLED =
+        parseBoolean(EnvironmentVariableUtils.getOrDefault("ENABLE_STATS_SCHEDULED_PARSING", "false"));
+
+    private static final String STATS_PARSING_SCHEDULE_HOUR = EnvironmentVariableUtils.getOrDefault("STATS_PARSING_SCHEDULE_HOUR", "*");
+    private static final String STATS_PARSING_SCHEDULE_MINUTE = EnvironmentVariableUtils.getOrDefault("STATS_PARSING_SCHEDULE_MINUTE", "55");
+    private static final String STATS_PARSING_SCHEDULE_SECOND = EnvironmentVariableUtils.getOrDefault("STATS_PARSING_SCHEDULE_SECOND", "0");
+    private static final String STATS_PARSING_SCHEDULE_FIRST_DAY_OF_MONTH =
+        EnvironmentVariableUtils.getOrDefault("STATS_PARSING_SCHEDULE_FIRST_DAY_OF_MONTH", "3");
+    private static final String STATS_PARSING_SCHEDULE_LAST_DAY_OF_MONTH =
+        EnvironmentVariableUtils.getOrDefault("STATS_PARSING_SCHEDULE_LAST_DAY_OF_MONTH", "31");
+
+    private final Object parsingLock = new Object();
+
+    @Autowired
+    private FoldingRepository foldingRepository;
+
+    @Autowired
+    private UserStatsParser userStatsParser;
+
+    /**
+     * Registers the stats parsing schedule, if scheduled parsing is enabled.
+     *
+     * @param taskRegistrar the {@link ScheduledTaskRegistrar}
+     */
+    @Override
+    public void configureTasks(final ScheduledTaskRegistrar taskRegistrar) {
+        if (!IS_STATS_SCHEDULED_PARSING_ENABLED) {
+            LOGGER.error("Scheduled TC stats parsing not enabled");
+            return;
+        }
+
+        final String cronExpression = String.format("%s %s %s %s-%s * *", STATS_PARSING_SCHEDULE_SECOND, STATS_PARSING_SCHEDULE_MINUTE,
+            STATS_PARSING_SCHEDULE_HOUR, STATS_PARSING_SCHEDULE_FIRST_DAY_OF_MONTH, STATS_PARSING_SCHEDULE_LAST_DAY_OF_MONTH);
+        taskRegistrar.addTriggerTask(this::scheduledTeamCompetitionStatsParsing, new CronTrigger(cronExpression, TimeZone.getTimeZone("UTC")));
+        LOGGER.info("Starting TC stats parser with schedule: {}", cronExpression);
+    }
+
+    /**
+     * Scheduled <code>Team Competition</code> stats parsing: each {@link User} is parsed asynchronously.
+     */
+    public void scheduledTeamCompetitionStatsParsing() {
+        try {
+            manualTeamCompetitionStatsParsing(ProcessingType.ASYNCHRONOUS);
+        } catch (final Exception e) {
+            LOGGER.error("Unexpected error updating TC stats", e);
+        }
+    }
+
+    /**
+     * Parses the <code>Team Competition</code> stats of every {@link User} on every {@link Team}.
+     *
+     * <p>
+     * The system is {@link SystemState#UPDATING_STATS} while the users are dispatched, and {@link SystemState#WRITE_EXECUTED}
+     * once they are; an error while parsing synchronously reaches the caller and leaves the system updating. Calls are
+     * serialised, as the original singleton's container lock serialised them.
+     *
+     * @param processingType whether each {@link User} is parsed asynchronously or synchronously
+     */
+    public void manualTeamCompetitionStatsParsing(final ProcessingType processingType) {
+        synchronized (parsingLock) {
+            LOGGER.debug("Manual stats parsing execution");
+            ParsingStateManager.next(ParsingState.ENABLED_TEAM_COMPETITION);
+            SystemStateManager.next(SystemState.UPDATING_STATS);
+            parseTeamCompetitionStats(processingType);
+            SystemStateManager.next(SystemState.WRITE_EXECUTED);
+        }
+    }
+
+    private void parseTeamCompetitionStats(final ProcessingType processingType) {
+        LOGGER.info("Parsing TC Folding stats:");
+        final Collection<Team> tcTeams = foldingRepository.getAllTeams();
+        if (tcTeams.isEmpty()) {
+            LOGGER.warn("No TC teams configured in system!");
+            return;
+        }
+
+        for (final Team team : tcTeams) {
+            // The parser needs each user's real passkey, so read the users with passkeys
+            final Collection<User> teamUsers = foldingRepository.getAllUsersWithPasskeys()
+                .stream()
+                .filter(user -> user.getTeam().getId() == team.getId())
+                .toList();
+            if (teamUsers.isEmpty()) {
+                LOGGER.warn("No users for team '{}'", team.getTeamName());
+                continue;
+            }
+
+            for (final User user : teamUsers) {
+                if (processingType == ProcessingType.ASYNCHRONOUS) {
+                    userStatsParser.parseTcStatsForUser(user);
+                } else {
+                    userStatsParser.parseTcStatsForUserAndWait(user);
+                }
+            }
+        }
+    }
+}
