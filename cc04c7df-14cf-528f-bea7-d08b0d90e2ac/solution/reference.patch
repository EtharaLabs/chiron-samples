+import javax.servlet.http.HttpServletResponse;
+import me.zodac.folding.api.util.EnvironmentVariableUtils;
+import org.apache.logging.log4j.LogManager;
+import org.apache.logging.log4j.Logger;
+import org.springframework.http.HttpHeaders;
+import org.springframework.http.HttpMethod;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.converter.HttpMessageNotReadableException;
+import org.springframework.web.HttpMediaTypeNotAcceptableException;
+import org.springframework.web.HttpMediaTypeNotSupportedException;
+import org.springframework.web.HttpRequestMethodNotSupportedException;
+import org.springframework.web.bind.annotation.ExceptionHandler;
+import org.springframework.web.bind.annotation.RestControllerAdvice;
+import org.springframework.web.servlet.NoHandlerFoundException;
+
+/**
+ * Maps request failures that no endpoint handles to the responses the original application gave: an unknown URL is
+ * redirected to the configured {@code REDIRECT_URL}, an unsupported method, media type or {@code Accept} header answers
+ * with its bare status, an unreadable payload with a plain error page, and an unexpected error with a server error page
+ * that carries none of the cross-origin headers.
+ */
+@RestControllerAdvice
+public class InvalidUrlRedirecter {
+
+    private static final Logger LOGGER = LogManager.getLogger();
+    private static final String REDIRECT_URL = EnvironmentVariableUtils.getOrDefault("REDIRECT_URL", "https://etf.axihub.ca/");
+
+    /**
+     * Any request to a URL that matches no endpoint is redirected with {@link HttpStatus#SEE_OTHER}.
+     *
+     * @param response the {@link HttpServletResponse}
+     */
+    @ExceptionHandler(NoHandlerFoundException.class)
+    public void redirectInvalidUrl(final HttpServletResponse response) {
+        response.setContentType(null);
+        response.setStatus(HttpStatus.SEE_OTHER.value());
+        response.setHeader(HttpHeaders.LOCATION, REDIRECT_URL);
+    }
+
+    /**
+     * A URL that matches an endpoint with another method answers {@link HttpStatus#METHOD_NOT_ALLOWED}.
+     *
+     * @param e        the {@link HttpRequestMethodNotSupportedException}
+     * @param response the {@link HttpServletResponse}
+     */
+    @ExceptionHandler(HttpRequestMethodNotSupportedException.class)
+    public void methodNotAllowed(final HttpRequestMethodNotSupportedException e, final HttpServletResponse response) {
+        final Set<HttpMethod> supported = e.getSupportedHttpMethods();
+        if (supported != null && !supported.isEmpty()) {
+            response.setHeader(HttpHeaders.ALLOW, supported.stream().map(HttpMethod::name).collect(Collectors.joining(", ")));
+        }
+        response.setStatus(HttpStatus.METHOD_NOT_ALLOWED.value());
+    }
+
+    /**
+     * A payload of a media type the endpoint does not consume answers {@link HttpStatus#UNSUPPORTED_MEDIA_TYPE}.
+     *
+     * @param response the {@link HttpServletResponse}
+     */
+    @ExceptionHandler(HttpMediaTypeNotSupportedException.class)
+    public void unsupportedMediaType(final HttpServletResponse response) {
+        response.setStatus(HttpStatus.UNSUPPORTED_MEDIA_TYPE.value());
+    }
+
+    /**
+     * An {@code Accept} header the endpoint cannot produce answers {@link HttpStatus#NOT_ACCEPTABLE}.
+     *
+     * @param response the {@link HttpServletResponse}
+     */
+    @ExceptionHandler(HttpMediaTypeNotAcceptableException.class)
+    public void notAcceptable(final HttpServletResponse response) {
+        response.setStatus(HttpStatus.NOT_ACCEPTABLE.value());
+    }
+
+    /**
+     * A payload that cannot be read as the expected JSON answers {@link HttpStatus#BAD_REQUEST} with a plain error page.
+     *
+     * @param e        the {@link HttpMessageNotReadableException}
+     * @param response the {@link HttpServletResponse}
+     * @throws IOException thrown if the error page cannot be written
+     */
+    @ExceptionHandler(HttpMessageNotReadableException.class)
+    public void unreadablePayload(final HttpMessageNotReadableException e, final HttpServletResponse response) throws IOException {
+        LOGGER.warn("Unreadable request payload", e);
+        writePage(response, HttpStatus.BAD_REQUEST, "Unable to read the request payload");
+    }
+
+    /**
+     * Any other unexpected error answers {@link HttpStatus#INTERNAL_SERVER_ERROR} with a server error page, without the
+     * cross-origin headers that only completed requests carry.
+     *
+     * @param e        the unexpected {@link Exception}
+     * @param response the {@link HttpServletResponse}
+     * @throws IOException thrown if the error page cannot be written
+     */
+    @ExceptionHandler(Exception.class)
+    public void unexpectedError(final Exception e, final HttpServletResponse response) throws IOException {
+        LOGGER.error("Unexpected error handling request", e);
+        if (!response.isCommitted()) {
+            response.reset();
+        }
+        writePage(response, HttpStatus.INTERNAL_SERVER_ERROR, "Internal Server Error");
+    }
+
+    private static void writePage(final HttpServletResponse response, final HttpStatus status, final String message) throws IOException {
+        response.setStatus(status.value());
+        response.setContentType("text/html;charset=UTF-8");
+        final byte[] page = ("<html><head><title>Error</title></head><body>" + message + "</body></html>")
+            .getBytes(StandardCharsets.UTF_8);
+        response.setContentLength(page.length);
+        response.getOutputStream().write(page);
+    }
+}
