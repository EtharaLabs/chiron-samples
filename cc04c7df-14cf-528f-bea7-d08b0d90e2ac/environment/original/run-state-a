#!/usr/bin/env bash
# Run the original application (State A) on WildFly 24 / JDK 11 with its stubbed external services.
# Usage: run-state-a [http-port]   (default 8081, so 8080 stays free for your own application)
# The original web archive is served at /folding and the stubs at / on the same port. Environment
# variables you set are passed through; unset ones default to the values below. Start a database
# first with /opt/original/start-postgres. Stop with Ctrl-C.
set -euo pipefail
port="${1:-8081}"
base="${STATE_A_HOME:-$HOME/.state-a-wildfly}"
if [ ! -d "$base" ]; then
  mkdir -p "$base"
  cp -R /opt/wildfly-24/standalone "$base/standalone"
fi
# Each start begins with no stored EJB timers, as the recorded runs did: State A's parsing
# timer is persistent by default, and WildFly would otherwise replay every earlier start's schedule.
rm -rf "$base/standalone/data/timer-service-data"
export JAVA_HOME=/opt/jdk-11
: "${LARS_URL_ROOT:=http://127.0.0.1:$port}" "${STATS_URL_ROOT:=http://127.0.0.1:$port}"
: "${REDIRECT_URL:=http://frontend.example}" "${DEPLOYED_DATABASE:=postgresql}"
: "${JDBC_CONNECTION_URL:=jdbc:postgresql://127.0.0.1:5432/folding_db}" "${JDBC_CONNECTION_USER:=folding_user}"
: "${JDBC_CONNECTION_PASSWORD:=shroot}" "${JDBC_CONNECTION_DRIVER:=org.postgresql.Driver}"
: "${ENABLE_LARS_HARDWARE_UPDATE:=false}" "${ENABLE_MONTHLY_RESULT_STORAGE:=false}"
: "${ENABLE_STATS_MONTHLY_RESET:=false}" "${ENABLE_STATS_SCHEDULED_PARSING:=false}"
: "${STATS_PARSING_SCHEDULE_HOUR:=*}" "${STATS_PARSING_SCHEDULE_MINUTE:=55}" "${STATS_PARSING_SCHEDULE_SECOND:=0}"
: "${STATS_PARSING_SCHEDULE_FIRST_DAY_OF_MONTH:=3}" "${STATS_PARSING_SCHEDULE_LAST_DAY_OF_MONTH:=31}"
: "${USERS_IN_AMD_GPU:=1}" "${USERS_IN_NVIDIA_GPU:=1}" "${USERS_IN_WILDCARD:=1}" "${TZ:=UTC}"
export LARS_URL_ROOT STATS_URL_ROOT REDIRECT_URL DEPLOYED_DATABASE JDBC_CONNECTION_URL JDBC_CONNECTION_USER \
  JDBC_CONNECTION_PASSWORD JDBC_CONNECTION_DRIVER ENABLE_LARS_HARDWARE_UPDATE ENABLE_MONTHLY_RESULT_STORAGE \
  ENABLE_STATS_MONTHLY_RESET ENABLE_STATS_SCHEDULED_PARSING STATS_PARSING_SCHEDULE_HOUR STATS_PARSING_SCHEDULE_MINUTE \
  STATS_PARSING_SCHEDULE_SECOND STATS_PARSING_SCHEDULE_FIRST_DAY_OF_MONTH STATS_PARSING_SCHEDULE_LAST_DAY_OF_MONTH \
  USERS_IN_AMD_GPU USERS_IN_NVIDIA_GPU USERS_IN_WILDCARD TZ
exec /opt/wildfly-24/bin/standalone.sh -b 127.0.0.1 "-Djboss.http.port=$port" \
  "-Djboss.server.base.dir=$base/standalone" -Djboss.management.http.port=$((port + 1909))
