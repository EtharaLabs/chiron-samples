     "displayName": "ProbeHw",
     "hardwareMake": "NVIDIA",
     "hardwareType": "GPU",
     "multiplier": 1.0,
     "averagePpd": 100
    }
   }
  },
  {
   "case": "list_read",
   "http": {
    "method": "GET",
    "path": "/hardware"
   },
   "capture": {
    "listTag": "header:ETag"
   }
  },
  {
   "case": "create_unrelated_team",
