    }
   }
  },
  {
   "case": "conditional_after_unrelated_write",
   "http": {
    "method": "GET",
    "path": "/hardware",
    "headers": {
     "If-None-Match": "${listTag}"
    }
   }
  },
  {
   "case": "create_second_hardware",
   "http": {
    "method": "POST",
    "path": "/hardware",
    "auth": "admin",
