{
 "id": "s3_family_54",
 "source": "f084_etag_changes_after_updating_the_same_resource",
 "steps": [
  {
   "case": "setup_hardware",
   "http": {
    "method": "POST",
    "path": "/hardware",
    "auth": "admin",
    "json": {
     "hardwareName": "ProbeHw",
     "displayName": "ProbeHw",
     "hardwareMake": "NVIDIA",
     "hardwareType": "GPU",
     "multiplier": 1.0,
     "averagePpd": 100
    }
   }
  },
  {
   "case": "read_before_update",
   "http": {
    "method": "GET",
    "path": "/hardware/1"
   },
   "capture": {
    "staleTag": "header:ETag"
   }
  },
  {
   "case": "update_display_name",
   "http": {
    "method": "PUT",
    "path": "/hardware/1",
    "auth": "admin",
    "json": {
     "hardwareName": "ProbeHw",
     "displayName": "RenamedProbeHw",
     "hardwareMake": "NVIDIA",
     "hardwareType": "GPU",
     "multiplier": 1.0,
     "averagePpd": 100
    }
   }
  },
  {
   "case": "conditional_with_stale_tag",
   "http": {
    "method": "GET",
    "path": "/hardware/1",
    "headers": {
     "If-None-Match": "${staleTag}"
    }
   },
   "capture": {
    "freshTag": "header:ETag"
   }
  },
  {
   "case": "conditional_with_fresh_tag",
   "http": {
    "method": "GET",
    "path": "/hardware/1",
    "headers": {
     "If-None-Match": "${freshTag}"
    }
   }
  }
 ],
