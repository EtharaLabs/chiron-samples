{
 "id": "s3_family_55",
 "source": "f086_if_none_match_list_syntax",
 "steps": [
  {
   "case": "setup_hardware",
   "http": {
    "method": "POST",
    "path": "/hardware",
    "auth": "admin",
    "json": {
     "hardwareName": "ProbeHw",
     "displayName": "ProbeHw",
     "hardwareMake": "NVIDIA",
     "hardwareType": "GPU",
     "multiplier": 1.0,
     "averagePpd": 100
    }
   }
  },
  {
   "case": "read_for_tag",
   "http": {
    "method": "GET",
    "path": "/hardware/1"
   },
   "capture": {
    "hwTag": "header:ETag"
   }
  },
  {
   "case": "list_without_spaces",
   "http": {
    "method": "GET",
    "path": "/hardware/1",
    "headers": {
     "If-None-Match": "\"a\",\"b\",${hwTag}"
    }
   }
  },
  {
   "case": "space_before_comma",
   "http": {
    "method": "GET",
    "path": "/hardware/1",
    "headers": {
     "If-None-Match": "${hwTag} , \"x\""
    }
   }
  },
  {
   "case": "wildcard_then_tag",
   "http": {
    "method": "GET",
    "path": "/hardware/1",
    "headers": {
     "If-None-Match": "*, \"x\""
    }
   }
  },
  {
   "case": "tag_then_wildcard",
   "http": {
    "method": "GET",
    "path": "/hardware/1",
    "headers": {
     "If-None-Match": "\"x\", *"
    }
   }
  }
 ],
