     "hardwareType": "GPU",
     "multiplier": 1.0,
     "averagePpd": 100
    }
   }
  },
  {
   "case": "accept_prefers_xml_allows_json",
   "http": {
    "method": "GET",
    "path": "/hardware/1",
    "headers": {
     "Accept": "application/xml;q=1.0, application/json;q=0.1"
    }
   }
  },
  {
   "case": "accept_low_quality_wildcard",
   "http": {
    "method": "GET",
    "path": "/hardware/1",
    "headers": {
     "Accept": "*/*;q=0.1"
    }
   }
  },
  {
