{
 "id": "s3_family_58",
 "source": "f090_distinct_tags_for_the_masked_and_unmasked_user",
 "steps": [
  {
   "case": "setup_hardware",
   "http": {
    "method": "POST",
    "path": "/hardware",
    "auth": "admin",
    "json": {
     "hardwareName": "ProbeHw",
     "displayName": "ProbeHw",
     "hardwareMake": "NVIDIA",
     "hardwareType": "GPU",
     "multiplier": 1.0,
     "averagePpd": 100
    }
   }
  },
  {
   "case": "setup_team",
   "http": {
    "method": "POST",
    "path": "/teams",
    "auth": "admin",
    "json": {
     "teamName": "ProbeTeam"
    }
   }
  },
  {
   "stub": {
    "method": "POST",
    "path": "/bonus?user=ProbeUser&passkey=ProbePasskey12345678901234567890&units=1"
   }
  },
  {
   "case": "setup_user",
   "http": {
    "method": "POST",
    "path": "/users",
    "auth": "admin",
    "json": {
     "foldingUserName": "ProbeUser",
     "displayName": "ProbeUser",
     "passkey": "ProbePasskey12345678901234567890",
     "category": "NVIDIA_GPU",
     "hardwareId": 1,
     "teamId": 1,
     "userIsCaptain": false
    }
   }
  },
  {
   "case": "masked_user_read",
   "http": {
    "method": "GET",
    "path": "/users/1"
   },
   "capture": {
    "maskedTag": "header:ETag"
   }
  },
  {
   "case": "unmasked_user_read",
   "http": {
    "method": "GET",
    "path": "/users/1/passkey",
    "auth": "admin"
   },
   "capture": {
    "unmaskedTag": "header:ETag"
   }
  },
  {
   "case": "masked_read_with_unmasked_tag",
   "http": {
    "method": "GET",
    "path": "/users/1",
    "headers": {
     "If-None-Match": "${unmaskedTag}"
    }
   }
  },
  {
   "case": "unmasked_read_with_masked_tag",
   "http": {
    "method": "GET",
    "path": "/users/1/passkey",
    "headers": {
     "If-None-Match": "${maskedTag}"
    },
    "auth": "admin"
   }
  },
  {
   "case": "masked_read_with_own_tag",
   "http": {
    "method": "GET",
    "path": "/users/1",
    "headers": {
     "If-None-Match": "${maskedTag}"
    }
   }
  }
 ],
