 "source": "f087_if_match_preconditions",
 "steps": [
  {
   "case": "setup_hardware",
   "http": {
    "method": "POST",
    "path": "/hardware",
    "auth": "admin",
    "json": {
     "hardwareName": "ProbeHw",
     "displayName": "ProbeHw",
     "hardwareMake": "NVIDIA",
     "hardwareType": "GPU",
     "multiplier": 1.0,
     "averagePpd": 100
    }
   }
  },
  {
   "case": "read_for_tag",
   "http": {
    "method": "GET",
    "path": "/hardware/1"
   },
   "capture": {
    "hwTag": "header:ETag"
   }
  },
  {
   "case": "if_match_matching_tag",
   "http": {
    "method": "GET",
    "path": "/hardware/1",
    "headers": {
     "If-Match": "${hwTag}"
    }
   }
  },
  {
   "case": "if_match_unknown_tag",
   "http": {
    "method": "GET",
    "path": "/hardware/1",
    "headers": {
     "If-Match": "\"deadbeef\""
    }
   }
  },
  {
   "case": "if_match_wildcard",
   "http": {
    "method": "GET",
    "path": "/hardware/1",
    "headers": {
     "If-Match": "*"
    }
   }
  },
  {
   "case": "if_match_list_including_tag",
   "http": {
    "method": "GET",
    "path": "/hardware/1",
    "headers": {
     "If-Match": "\"deadbeef\", ${hwTag}"
    }
   }
  }
 ],
