+"""HTTP answers Argus gives outside its route handlers.
+
+Unmatched URLs, wrong methods, HEAD and OPTIONS requests, missing trailing slashes and redirects
+get the pages and status codes Argus clients already rely on, and the session lives in a
+browser-session cookie:
+
+- 400, 404 and 405 are HTML error pages, on every path;
+- a URL whose rule ends with a slash, requested without it, redirects with 308 to the slashed
+  URL (absolute, query kept); a URL requested with a slash its rule does not have is a 404;
+- every redirect carries the short HTML page naming its target;
+- a URL with repeated slashes inside it redirects with 308 to the URL with them merged when that
+  URL is served, and leading slashes are ignored;
+- a path parameter is never empty;
+- HEAD is served by a route that declares it, else answers as GET without a body; OPTIONS
+  answers 200 with the allowed methods; a response that names no content type is HTML;
+- a query parameter given more than once takes its first value, unless it is a list parameter;
+- the session cookie lives for the browser session: HttpOnly, Path=/, no lifetime, no SameSite.
+"""
+
+from __future__ import annotations
+
+import json
+import re
+from base64 import b64decode, b64encode
+from html import escape
+from urllib.parse import quote, unquote_plus
+
+import itsdangerous
+from itsdangerous.exc import BadSignature
+from starlette.datastructures import MutableHeaders
+from starlette.exceptions import HTTPException as StarletteHTTPException
+from starlette.middleware.sessions import Session
+from starlette.requests import HTTPConnection, Request
+from starlette.responses import HTMLResponse, RedirectResponse
+from starlette.convertors import Convertor, register_url_convertor
+from starlette.routing import Match, Mount
+from starlette.types import ASGIApp, Message, Receive, Scope, Send
+
+ERROR_PAGES = {
+    400: ("Bad Request", "The browser (or proxy) sent a request that this server could not understand."),
+    404: (
+        "Not Found",
+        "The requested URL was not found on the server. If you entered the URL manually please "
+        "check your spelling and try again.",
+    ),
+    405: ("Method Not Allowed", "The method is not allowed for the requested URL."),
+}
+REDIRECT_STATUSES = {301, 302, 303, 307, 308}
+HTML = "text/html; charset=utf-8"
+# The query parameters Argus reads as lists; every other parameter is single-valued.
+LIST_PARAMETERS = frozenset(
+    {"tableNames[]", "additionalRuns[]", "severity", "status[]", "filters[]", "markers[]"}
+)
+# Characters a path segment may carry unescaped, slash included.
+SEGMENT_SAFE = "!$&'()*+,/:;=@"
+
+
+class SegmentPath(Convertor):
+    """A ``path`` parameter: one character or more, the first of them not a slash."""
+
+    regex = "[^/].*?"
+
+    def convert(self, value: str) -> str:
+        return str(value)
+
+    def to_string(self, value: object) -> str:
+        return str(value)
+
+
+def register_path_convertor() -> None:
+    """Make ``{name:path}`` mean :class:`SegmentPath`; called before any route is declared."""
+    register_url_convertor("path", SegmentPath())
+
+
+def error_page(status: int, headers: dict[str, str] | None = None) -> HTMLResponse:
+    name, description = ERROR_PAGES[status]
+    body = (
+        f"<!doctype html>\n<html lang=en>\n<title>{status} {name}</title>\n<h1>{name}</h1>\n"
+        f"<p>{escape(description)}</p>\n"
+    )
+    return HTMLResponse(body, status_code=status, headers=headers)
+
+
+def redirect_page(location: str) -> bytes:
+    target = escape(location)
+    return (
+        "<!doctype html>\n<html lang=en>\n<title>Redirecting...</title>\n<h1>Redirecting...</h1>\n"
+        "<p>You should be redirected automatically to the target URL: "
+        f'<a href="{target}">{target}</a>. If not, click the link.\n'
+    ).encode()
+
+
+def _route_matches(app, scope: Scope, full: bool = False) -> list:
+    """The routes whose path matches ``scope``: whatever their methods, or with ``full`` only
+    the routes (never a mount, which takes every path under it) that also serve its method."""
+    found = []
+    for route in app.router.routes:
+        if full and isinstance(route, Mount):
+            continue
+        match, _ = route.matches(scope)
+        if match == Match.FULL or (match != Match.NONE and not full):
+            found.append(route)
+    return found
+
+
+def _served(app, scope: Scope, path: str) -> bool:
+    """Whether a route serves ``path`` for the request's method; OPTIONS is served by every route."""
+    probe = dict(scope, path=path)
+    if scope["method"] == "OPTIONS":
+        return any(not isinstance(route, Mount) for route in _route_matches(app, probe))
+    return bool(_route_matches(app, probe, full=True))
+
+
+def _absolute(request: Request, path: str) -> str:
+    location = f"{request.url.scheme}://{request.headers.get('host', request.url.netloc)}{path}"
+    query = request.scope.get(ORIGINAL_QUERY, request.scope.get("query_string", b"")).decode("latin-1")
+    return f"{location}?{query}" if query else location
+
+
+# the query string as the client sent it, kept for the redirects that carry it on
+ORIGINAL_QUERY = "argus.original_query_string"
+
+
+def _first_values(query_string: bytes) -> bytes:
+    """``query_string`` with every single-valued parameter reduced to its first occurrence."""
+    if b"&" not in query_string:
+        return query_string
+    kept, seen = [], set()
+    for part in query_string.split(b"&"):
+        name = unquote_plus(part.split(b"=", 1)[0].decode("latin-1"))
+        if name in seen and name not in LIST_PARAMETERS:
+            continue
+        seen.add(name)
+        kept.append(part)
+    return b"&".join(kept)
+
+
+def _allowed_methods(routes: list) -> list[str]:
+    methods: set[str] = set()
+    for route in routes:
+        methods |= set(getattr(route, "methods", None) or {"GET", "HEAD"})
+    if "GET" in methods:
+        methods.add("HEAD")
+    methods.add("OPTIONS")
+    return sorted(methods)
+
+
+async def http_exception_handler(request: Request, exc: StarletteHTTPException):
+    """Router and route errors as HTML pages, and the strict-slash and merged-slash redirects.
+
+    Both redirects go only to a URL served for the request's method; otherwise the 404 stands.
+    """
+    path = request.scope["path"]
+    if exc.status_code == 404:
+        if not path.endswith("/") and _served(request.app, request.scope, path + "/"):
+            return RedirectResponse(_absolute(request, quote(path + "/", safe=SEGMENT_SAFE)), status_code=308)
+        merged = re.sub("/{2,}?", "/", path)
+        if merged != path:
+            if _served(request.app, request.scope, merged):
+                return RedirectResponse(_absolute(request, quote(merged, safe=SEGMENT_SAFE)), status_code=308)
+            if not merged.endswith("/") and _served(request.app, request.scope, merged + "/"):
+                return RedirectResponse(_absolute(request, quote(merged + "/", safe=SEGMENT_SAFE)), status_code=308)
+    if exc.status_code in ERROR_PAGES:
+        return error_page(exc.status_code, dict(exc.headers or {}))
+    return HTMLResponse(str(exc.detail), status_code=exc.status_code, headers=exc.headers)
+
+
+class StandardAnswers:
+    """Request paths and query strings read the way Argus reads them, HEAD and OPTIONS answered
+    for every route, every redirect given its page and every response a content type."""
+
+    def __init__(self, app: ASGIApp, application) -> None:
+        self.app = app
+        self.application = application
+
+    async def __call__(self, scope: Scope, receive: Receive, send: Send) -> None:
+        if scope["type"] != "http":
+            await self.app(scope, receive, send)
+            return
+        path = scope["path"]
+        if path.startswith("//"):
+            stripped = "/" + path.lstrip("/")
+            scope = dict(scope, path=stripped, raw_path=stripped.encode("latin-1"))
+        query_string = scope.get("query_string", b"")
+        if query_string:
+            scope = dict(scope, query_string=_first_values(query_string))
+            scope[ORIGINAL_QUERY] = query_string
+        method = scope["method"]
+        if method == "OPTIONS":
+            routes = _route_matches(self.application, dict(scope, method="GET"))
+            if routes:
+                headers = {"Allow": ", ".join(_allowed_methods(routes))}
+                response = HTMLResponse("", status_code=200, headers=headers)
+                await response(scope, receive, send)
+                return
+        head = method == "HEAD" and not _route_matches(self.application, scope, full=True)
+        if head:
+            scope = dict(scope, method="GET")
+        held: dict = {}
+
+        async def wrapped(message: Message) -> None:
+            if message["type"] == "http.response.start":
+                headers = MutableHeaders(scope=message)
+                if (
+                    message["status"] in REDIRECT_STATUSES
+                    and "location" in headers
+                    and "content-type" not in headers
+                ):
+                    body = redirect_page(headers["location"])
+                    headers["content-type"] = HTML
+                    headers["content-length"] = str(len(body))
+                    held["body"] = body
+                elif "content-type" not in headers:
+                    headers["content-type"] = HTML
+                await send(message)
+                return
+            if message["type"] == "http.response.body":
+                if "body" in held:
+                    if not message.get("more_body", False):
+                        await send({"type": "http.response.body", "body": b"" if head else held["body"]})
+                    return
+                if head:
+                    message = dict(message, body=b"")
+            await send(message)
+
+        await self.app(scope, receive, wrapped)
+
+
+class BrowserSessionMiddleware:
+    """The signed session cookie, scoped to the browser session."""
+
+    def __init__(self, app: ASGIApp, secret_key: str, session_cookie: str = "session",
+                 max_age: int = 31 * 24 * 60 * 60, https_only: bool = False) -> None:
+        self.app = app
+        self.signer = itsdangerous.TimestampSigner(str(secret_key))
+        self.session_cookie = session_cookie
+        self.max_age = max_age
+        self.flags = "HttpOnly; Path=/" + ("; Secure" if https_only else "")
+
+    async def __call__(self, scope: Scope, receive: Receive, send: Send) -> None:
+        if scope["type"] not in ("http", "websocket"):
+            await self.app(scope, receive, send)
+            return
+        connection = HTTPConnection(scope)
+        had_cookie = False
+        scope["session"] = Session()
+        if self.session_cookie in connection.cookies:
+            data = connection.cookies[self.session_cookie].encode("utf-8")
+            try:
+                data = self.signer.unsign(data, max_age=self.max_age)
+                scope["session"] = Session(json.loads(b64decode(data)))
+                had_cookie = True
+            except BadSignature:
+                pass
+
+        async def wrapped(message: Message) -> None:
+            if message["type"] == "http.response.start":
+                session: Session = scope["session"]
+                headers = MutableHeaders(scope=message)
+                if session.accessed:
+                    headers.add_vary_header("Cookie")
+                if session.modified and session:
+                    data = self.signer.sign(b64encode(json.dumps(session).encode("utf-8")))
+                    headers.append("Set-Cookie", f"{self.session_cookie}={data.decode()}; {self.flags}")
+                elif session.modified and had_cookie:
+                    headers.append(
+                        "Set-Cookie",
+                        f"{self.session_cookie}=; Expires=Thu, 01 Jan 1970 00:00:00 GMT; Max-Age=0; {self.flags}",
+                    )
+            await send(message)
+
+        await self.app(scope, receive, wrapped)
