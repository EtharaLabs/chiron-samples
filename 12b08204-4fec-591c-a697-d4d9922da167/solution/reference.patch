+def profile_field(name: str):
+    """A profile form field, taken from the query string or else the form body; the first value
+    given wins and an empty value is kept, so the profile forms and scripted callers that put
+    the field in the URL both keep working."""
+    def value(in_query: str | None = Query(None, alias=name),
+              in_form: list[str] | None = Form(None, alias=name)) -> str | None:
+        if in_query is not None:
+            return in_query
+        return in_form[0] if in_form else None
+    return value
+
